{
  "name": "dsh-agent-md",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "全局 AGENT.md 人格：注入系统提示 + 设置里一个只编辑全局人格的页面（无项目人格）。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "persona",
    "agent-md"
